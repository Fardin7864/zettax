NODE_ENV=development
BACKEND_PORT=3000
ADMIN_PORT=3001
POSTGRES_DB=primevest
POSTGRES_USER=primevest
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql://primevest:change-me-locally@postgres:5432/primevest?schema=public
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=change-me-redis
MINIO_ROOT_USER=primevest-local
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=primevest-private
MINIO_ACCESS_KEY=primevest-local
MINIO_SECRET_KEY=change-me-minio
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-char-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
MFA_ENCRYPTION_KEY=
ENABLE_PREDICTIONS=false
PREDICTION_REAL_APPROVAL_REFERENCE=
# Hostinger mailbox credentials belong in the deployment secret store, never source control.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@zettax.com
GOOGLE_WEB_CLIENT_ID=
CORS_ORIGINS=http://localhost:3001
COMPLIANCE_MODE=SANDBOX
ENABLE_REAL_TRADING=true
ENABLE_CRYPTO_TRADING=true
ENABLE_FOREX_TRADING=true
ENABLE_STOCK_TRADING=true
ENABLE_COMMODITY_TRADING=true
ENABLE_INDEX_TRADING=true
ENABLE_TIMED_TRADING=true
ENABLE_DEPOSITS=true
ENABLE_WITHDRAWALS=true
EXECUTION_PROVIDER=MOCK
# Optional development/evaluation credential. A Twelve Data free or individual
# plan does not grant PrimeVest commercial external-display/redistribution rights.
# Production use requires a suitable business agreement and any exchange licences.
TWELVE_DATA_API_KEY=
TWELVE_DATA_DISPLAY_LICENSE_APPROVED=false
TWELVE_DATA_REQUESTS_PER_MINUTE=8
MARKET_DATA_CACHE_MAX_ENTRIES=500
PRODUCTION_APPROVAL_REFERENCE=
EXECUTION_PROVIDER_APPROVAL_REFERENCE=
DEMO_INITIAL_BALANCE_USD=1000.00
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
API_DOMAIN=api.zettax.app
ADMIN_DOMAIN=admin.zettax.app
ADMIN_ALLOW_CIDR=127.0.0.1/32
TLS_CERTIFICATE_PATH=/etc/letsencrypt/live/zettax.app/fullchain.pem
TLS_CERTIFICATE_KEY_PATH=/etc/letsencrypt/live/zettax.app/privkey.pem
