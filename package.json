{
  "name": "primevest",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @primevest/backend --filter @primevest/admin --filter @primevest/web dev",
    "dev:supabase": "powershell -NoProfile -ExecutionPolicy Bypass -File infrastructure/scripts/start-supabase-dev.ps1",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/platform-express>multer": "^2.5.0",
      "@nestjs/platform-express>express": "^5.3.0",
      "body-parser@^2.0.0": "^2.4.0",
      "postcss@^8.0.0": "^8.5.23",
      "js-yaml@^5.0.0": "^5.4.1",
      "qs@^6.0.0": "^6.16.1",
      "@prisma/config>deepmerge-ts": "^8.0.0"
    }
  }
}
