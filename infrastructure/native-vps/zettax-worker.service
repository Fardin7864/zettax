[Unit]
Description=Zettax financial settlement worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zettax
Group=zettax
WorkingDirectory=/srv/zettax/current
EnvironmentFile=/srv/zettax/shared/production.env
ExecStart=/usr/bin/node /srv/zettax/current/apps/backend/dist/apps/backend/src/workers/financial-worker.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
