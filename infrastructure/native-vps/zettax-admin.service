[Unit]
Description=Zettax operations console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zettax
Group=zettax
WorkingDirectory=/srv/zettax/current/apps/admin
EnvironmentFile=/srv/zettax/shared/production.env
ExecStart=/usr/bin/node /srv/zettax/current/apps/admin/node_modules/next/dist/bin/next start -p 3001 -H 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
