# Template only. Never deploy these placeholder values.
NODE_ENV=production
# Exact private admin HTTPS origin and its hostname (no scheme for RP ID).
WEBAUTHN_RP_ID=admin.zettax.app
WEBAUTHN_ORIGIN=https://admin.zettax.app
# Place a separately backed-up 32-byte raw key at /srv/primevest/secrets/evidence.key.
# Owner root, group 1000, mode 0440; distribute through the encrypted secret bundle.
APP_VERSION=REPLACE_WITH_IMMUTABLE_RELEASE_VERSION
PRIMEVEST_DATA_ROOT=/srv/primevest

POSTGRES_DB=primevest
POSTGRES_USER=primevest
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://primevest:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/primevest?schema=public
POSTGRES_APP_USER=primevest_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_RANDOM_APP_DATABASE_PASSWORD
POSTGRES_MIGRATION_USER=primevest_migrate
POSTGRES_MIGRATION_PASSWORD=REPLACE_WITH_RANDOM_MIGRATION_DATABASE_PASSWORD
POSTGRES_MONITOR_USER=primevest_monitor
POSTGRES_MONITOR_PASSWORD=REPLACE_WITH_RANDOM_MONITOR_DATABASE_PASSWORD

REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_REDIS_PASSWORD@redis:6379

MINIO_ROOT_USER=REPLACE_WITH_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_MINIO_ROOT_PASSWORD
MINIO_BUCKET=primevest-private
MINIO_KYC_BUCKET=primevest-kyc
MINIO_PAYMENT_BUCKET=primevest-payments
MINIO_REPORTS_BUCKET=primevest-reports
MINIO_UPLOADS_BUCKET=primevest-uploads
MINIO_ACCESS_KEY=REPLACE_WITH_PROVISIONED_APP_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_PROVISIONED_APP_SECRET_KEY

JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHAR_SECRET
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_OAUTH_CLIENT_ID

API_DOMAIN=api.zettax.app
ADMIN_DOMAIN=admin.zettax.app
STATUS_DOMAIN=status.zettax.app
CORS_ORIGINS=https://admin.zettax.app
NEXT_PUBLIC_API_URL=https://api.zettax.app/api/v1
ADMIN_ALLOW_CIDR=203.0.113.10/32
STATUS_ALLOW_CIDR=203.0.113.10/32
TLS_CERTIFICATE_PATH=/etc/letsencrypt/live/zettax.app/fullchain.pem
TLS_CERTIFICATE_KEY_PATH=/etc/letsencrypt/live/zettax.app/privkey.pem

COMPLIANCE_MODE=DEMO_ONLY
ENABLE_REAL_TRADING=false
ENABLE_CRYPTO_TRADING=false
ENABLE_FOREX_TRADING=false
ENABLE_STOCK_TRADING=false
ENABLE_COMMODITY_TRADING=false
ENABLE_INDEX_TRADING=false
ENABLE_TIMED_TRADING=true
ENABLE_DEPOSITS=false
ENABLE_WITHDRAWALS=false
EXECUTION_PROVIDER=MOCK
PRODUCTION_APPROVAL_REFERENCE=
EXECUTION_PROVIDER_APPROVAL_REFERENCE=

GRAFANA_ADMIN_USER=primevest-operator
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_GRAFANA_PASSWORD

# Offsite repository settings are consumed by the backup runner and must be
# supplied through a protected root-owned environment file, never committed.
RESTIC_REPOSITORY=s3:https://OFFSITE_S3_ENDPOINT/primevest-backups
RESTIC_PASSWORD=REPLACE_WITH_RANDOM_RESTIC_REPOSITORY_PASSWORD
AWS_ACCESS_KEY_ID=REPLACE_WITH_OFFSITE_BACKUP_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_OFFSITE_BACKUP_SECRET_KEY

# pgBackRest continuously archives PostgreSQL WAL to a separate prefix in the
# encrypted offsite repository. Endpoint is a hostname without https://.
PGBACKREST_S3_BUCKET=primevest-postgres-backups
PGBACKREST_S3_ENDPOINT=OFFSITE_S3_ENDPOINT
PGBACKREST_S3_REGION=REPLACE_WITH_OFFSITE_REGION
PGBACKREST_S3_KEY=REPLACE_WITH_POSTGRES_BACKUP_ACCESS_KEY
PGBACKREST_S3_KEY_SECRET=REPLACE_WITH_POSTGRES_BACKUP_SECRET_KEY
PGBACKREST_CIPHER_PASS=REPLACE_WITH_RANDOM_PGBACKREST_CIPHER_PASSWORD

TWELVE_DATA_API_KEY=
TWELVE_DATA_EXTERNAL_DISPLAY_APPROVED=false
TWELVE_DATA_DISPLAY_LICENSE_APPROVED=false
TWELVE_DATA_REQUESTS_PER_MINUTE=8
MARKET_DATA_CACHE_MAX_ENTRIES=500
