# Copy this file to .env.local. Never commit the populated file.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?schema=primevest&pgbouncer=true&connection_limit=10

# Local browser/mobile routing
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
CORS_ORIGINS=http://localhost:3001

# Supabase replaces local PostgreSQL. These services are optional for local UI/API work.
# Production keeps both checks enabled by default.
HEALTH_REQUIRE_REDIS=false
HEALTH_REQUIRE_OBJECT_STORAGE=false
RELEASE_VERSION=primevest-production-2026-09-v1

# REAL-labelled accounts use virtual funds in local development.
COMPLIANCE_MODE=SANDBOX
ENABLE_REAL_TRADING=true
ENABLE_CRYPTO_TRADING=true
ENABLE_FOREX_TRADING=true
ENABLE_STOCK_TRADING=true
ENABLE_COMMODITY_TRADING=true
ENABLE_INDEX_TRADING=true
ENABLE_TIMED_TRADING=true
ENABLE_DEPOSITS=true
ENABLE_WITHDRAWALS=true
EXECUTION_PROVIDER=MOCK

# Private Supabase screenshot storage (server-only credentials).
EVIDENCE_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=primevest-evidence
# Alternatively use the S3 access-key pair (no service-role key required):
# EVIDENCE_STORAGE_PROVIDER=supabase-s3
# SUPABASE_S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_S3_REGION=us-east-1
# Deposit screenshots require an encryption key, but no scanner or Docker.
# MINIO_ENDPOINT=
# MINIO_PORT=443
# MINIO_SSL=true
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_EVIDENCE_BUCKET=primevest-evidence
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# EVIDENCE_ENCRYPTION_KEY_FILE=
